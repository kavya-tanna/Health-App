# ==============================================================================
# HEALTH+ APPLICATION ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env.local to configure cloud backend services
# ==============================================================================

# Supabase Cloud Project Configuration (Optional)
# If provided, the application can sync with a remote PostgreSQL Supabase instance.
# If omitted, the application operates in 100% resilient offline-first local mode.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration
VITE_APP_NAME="HEALTH+"
VITE_ENABLE_AUDIT_LOGGING=true
VITE_MAX_UPLOAD_SIZE_MB=15
